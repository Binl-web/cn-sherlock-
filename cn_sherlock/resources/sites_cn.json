    },
    {
      "name": "快手",
      "category": "短视频",
      "status": "manual",
      "confidence": "none",
      "manual_url": "https://www.kuaishou.com/search/video?searchKey={username}",
      "reason": "主页使用数字 ID，网页端为纯前端渲染并带签名校验。"
    },
    {
      "name": "微信",
      "category": "即时通讯",
      "status": "manual",
      "confidence": "none",
      "manual_url": "https://weixin.qq.com/",
